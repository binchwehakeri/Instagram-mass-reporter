# --- Claude ---
ANTHROPIC_API_KEY=

# --- Exchange (any ccxt exchange id: binance, coinbase, kraken, bybit, ...) ---
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. Coinbase, KuCoin, OKX) also need a passphrase
EXCHANGE_PASSWORD=
# true = use the exchange's testnet/sandbox when it has one
EXCHANGE_SANDBOX=false

# --- Mode ---
# paper = simulated fills against real prices (default, no keys needed)
# live  = real orders with real money
MODE=paper
# Live mode refuses to start unless this is set exactly:
LIVE_TRADING_CONFIRM=

# --- What to trade ---
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
LOOP_SECONDS=300
PAPER_STARTING_CASH=10000

# --- Hard risk limits (enforced in code; Claude cannot exceed them) ---
MAX_POSITION_PCT=0.10        # max 10% of equity in any one coin
MAX_TOTAL_EXPOSURE_PCT=0.30  # max 30% of equity in crypto overall
RISK_PER_TRADE_PCT=0.01      # lose at most ~1% of equity if the stop is hit
MAX_DAILY_LOSS_PCT=0.03      # halt trading for the day after -3%
MAX_TRADES_PER_DAY=6
STOP_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=4.0
MIN_ORDER_USD=10

# --- Claude reviewer ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Below this confidence (0-1) a trade is skipped even if Claude approves
MIN_CLAUDE_CONFIDENCE=0.6
